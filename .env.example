# Добавляйте значения только в Vercel → Settings → Environment Variables.
# Никогда не коммитьте настоящий .env или токен Telegram.
BOT_TOKEN=123456789:replace_with_real_token
BOT_USERNAME=Polytech_homework_bot
TELEGRAM_WEBHOOK_SECRET=generate_a_random_32_character_secret
SETUP_SECRET=generate_a_different_random_32_character_secret
PUBLIC_BASE_URL=https://your-project.vercel.app

# Их автоматически добавляет интеграция Upstash Redis.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_token
